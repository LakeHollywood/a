# STS Core Command Anchor Server — resource-isolated systemd unit
#
# Purpose: pin the daemon's CPU/memory so a stress-ng chaos run on the same
# host cannot starve signature verification, WORM commits, or the
# ApprovalGate. The edge-side AnchorClient is fail-closed by design (batches
# stay PENDING in the quarantine queue and retry), but the server must remain
# responsive even under adversarial load, hence these hard caps + high weight.
#
# INSTALL (Jetson AGX Orin / L4T or any systemd host):
#     sudo cp bench/systemd/sts-core-command.slice /etc/systemd/system/
#     sudo cp bench/systemd/sts-core-command.service /etc/systemd/system/
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now sts-core-command.service
#
# VERIFY THE LIMITS APPLIED:
#     systemctl show sts-core-command -p CPUQuotaPerSecUSec -p MemoryMax -p CPUWeight
#     cat /proc/$(pgrep -f 'uvicorn main:app' | head -1)/cgroup   # expect .../sts-core-command.slice/...
#
# TUNING NOTES:
#   * CPUQuota=20%  -> 0.2 CPU-seconds per wall second. Ed25519 verify is
#     ~50-80 us/core; 20% comfortably sustains ~2k anchors/s with headroom.
#     Raise to 30% only if you batch >5k anchors/s per flush.
#   * MemoryMax=512M -> uvicorn+fastapi+pynacl RSS measured ~60 MB; 512M is
#     an 8x safety margin for large batch bodies without inviting swap.
#   * MemoryHigh=384M soft-throttles (reclaims page cache) BEFORE the hard
#     cap kills anything — avoids sudden OOM-kill mid-commit.
#   * CPUWeight=150 makes the slice win scheduling against stress-ng's
#     default weight of 100 even when the box is saturated.
#   * ManagedOOMPreference=omit ensures systemd-oomd never picks this daemon
#     as its victim during memory pressure events.

[Unit]
Description=STS Core Command Anchor Server (WORM ledger API)
Documentation=file:///workspace/bench/main.py
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=/workspace/bench
ExecStart=/usr/local/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Environment=PYTHONUNBUFFERED=1
Environment=STS_DB_PATH=/workspace/bench/core_command_worm.db
Environment=APPROVALGATE_DB_PATH=/workspace/bench/approvalgate.db
# Environment=APPROVALGATE_OPERATOR_PUBKEYS_B64=<operator pubkeys, comma-separated>

Slice=sts-core-command.slice

# --- Hard caps requested by ops: prevent stress-ng starvation ---------------
CPUQuota=20%
MemoryMax=512M

# --- Complementary isolation (recommended, not strictly required) -----------
MemoryHigh=384M            # soft throttle before the hard kill line
CPUWeight=150              # out-schedule stress-ng workers (default 100)
TasksMax=128               # bound thread/fork explosion from the event loop
ManagedOOMPreference=omit  # exempt from systemd-oomd victim selection
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/workspace/bench
PrivateTmp=true

StandardOutput=append:/workspace/bench/server.log
StandardError=append:/workspace/bench/server.log

[Install]
WantedBy=multi-user.target
